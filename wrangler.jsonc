{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "meatandcheezz",
  "main": "src/index.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/img/u/*"],
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "meatandcheezz",
      "database_id": "11d82cb9-90ed-4e24-a7c6-dce43887184e",
      "migrations_dir": "migrations"
    }
  ],
  // lets src/seed.js import the schema file as text
  "rules": [{ "type": "Text", "globs": ["**/*.sql"], "fallthrough": true }],
  "observability": { "enabled": true }
}
